# Enterprise Safe SQL Copilot Environment Variables

PROJECT_NAME="Enterprise Safe SQL Copilot"
ENVIRONMENT=development

# Database Connection (Read-Only Least Privilege Role)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_db
POSTGRES_USER=readonly_analyst
POSTGRES_PASSWORD=readonly_analyst_password

# Database Admin Credentials (Provisioning / Migration only)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_password

# Database Connection Pool Settings
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=10.0

# LLM Configuration (OpenAI / Groq / OpenAI-compatible endpoint)
LLM_API_KEY=mock
LLM_MODEL_NAME=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Security & Execution Timeouts
QUERY_TIMEOUT_SECONDS=30
STATEMENT_TIMEOUT_MS=2500
REQUEST_TIMEOUT_SECONDS=60
MAX_ROWS_LIMIT=1000
SCHEMA_CACHE_TTL_SECONDS=600
